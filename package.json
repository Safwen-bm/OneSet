{
  "name": "oneset",
  "private": true,
  "version": "0.1.0",
  "description": "OneSet — premium tech & gaming setup store. Full-stack monorepo (Next.js + NestJS + Prisma).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm run build -w @oneset/types",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:web": "npm run dev -w @oneset/web",
    "dev:api": "npm run start:dev -w @oneset/api",
    "build": "npm run build -w @oneset/types && npm run build -w @oneset/api && npm run build -w @oneset/web",
    "test": "npm run test -w @oneset/types",
    "lint": "npm run lint -w @oneset/web",
    "typecheck": "npm run typecheck -w @oneset/web && npm run typecheck -w @oneset/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w @oneset/api",
    "db:seed": "npm run prisma:seed -w @oneset/api",
    "db:studio": "npm run prisma:studio -w @oneset/api",
    "db:reset": "npm run prisma:reset -w @oneset/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
