# Copy to apps/api/.env and apps/web/.env.local (see README)
DATABASE_URL="postgresql://oneset:oneset@localhost:5432/oneset?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Optional — leave unset and checkout runs in a built-in demo payment mode.
# Add a Stripe test secret key to switch to real Stripe PaymentIntents, no code changes.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="usd"
